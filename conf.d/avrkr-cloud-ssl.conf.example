# Optional HTTPS for Avrkr Cloud.
# 1. Ensure certificate files exist (adjust paths if needed).
# 2. Copy to conf.d: cp avrkr-cloud-ssl.conf.example /etc/nginx/conf.d/avrkr-cloud-ssl.conf
# 3. nginx -t && systemctl reload nginx
#
# Rocky Linux self-signed (if created):
#   ssl_certificate     /etc/pki/nginx/server.crt;
#   ssl_certificate_key /etc/pki/nginx/private/server.key;
#
# Or reuse Asterisk TLS certs (common on this platform):
#   /etc/asterisk/keys/asterisk.crt
#   /etc/asterisk/keys/asterisk.key

upstream avrkr_nextjs {
    server 127.0.0.1:3000;
}

upstream avrkr_realtime {
    server 127.0.0.1:3001;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name app.avrkr.tech;

    ssl_certificate     /etc/asterisk/keys/asterisk.crt;
    ssl_certificate_key /etc/asterisk/keys/asterisk.key;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    location / {
        proxy_pass http://avrkr_nextjs;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /ws {
        proxy_pass http://avrkr_realtime/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name sip.avrkr.tech;

    ssl_certificate     /etc/asterisk/keys/asterisk.crt;
    ssl_certificate_key /etc/asterisk/keys/asterisk.key;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    location /ws {
        proxy_pass https://127.0.0.1:8089/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_ssl_verify off;
    }
}
